PORT=3000
BASE_URL=mongodb+srv://username:password@cluster.example.mongodb.net/dbname
# BASE_URL=mongodb://127.0.0.1:27017/dbname
JWT_SECRET=dummy_jwt_secret
NODE_ENV=dev
# Process role (API / worker split). Unset or APP_ROLE=all = monolith (HTTP + crons + BullMQ).
# For dual-process local test: run two processes with the same .env + different APP_ROLE/PORT:
#   APP_ROLE=api     NODE_ENV=prodtest PORT=4020 node backend/server.js
#   APP_ROLE=worker  NODE_ENV=prodtest PORT=4021 node backend/server.js
# APP_ROLE=api
# APP_ROLE=worker
ADMIN_ACCESS_TOKEN=dummy_admin_access_token
ADMIN_ACCESS_TOKEN_SIGNUP=

API_BASE_URL=http://localhost:3000/api/v1/
EMAIL_VERIFICATION_LINK=https://tiles-gba-kenneth-national.trycloudflare.com/api/v1/auth/link/verify-email?token=
EMAIL_VERIFICATION_REDIRECT_URL=https://tiles-gba-kenneth-national.trycloudflare.com/
PASSWORD_RESET_LINK=http://localhost:3000/api/v1/auth/link/reset-password/verify?token=
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password/

#Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=dummy_storage_account
AZURE_STORAGE_ACCOUNT_KEY=dummy_storage_key
AZURE_STORAGE_CONTAINER_NAME=dummy_container
AZURE_STORAGE_BASE_URL=https://dummy_storage_account.blob.core.windows.net/dummy_container/

# Mailgun settings for email sending
MAILGUN_API_KEY=dummy_mailgun_api_key
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=example.com
# Webhook auth for POST /api/v1/webhooks/mailgun/delivery (HMAC signing key and/or shared secret header)
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_WEBHOOK_SECRET=

OPENAI_API_KEY=

#BOOTSTRAP STARTUP USERS
BOOTSTRAP_GUEST_EMAIL=
BOOTSTRAP_GUEST_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Billko fiscal invoicing (runs after Monri capture; not a payment gateway)
BILLKO_BASE_URL=https://test.billko.eu
BILLKO_TEST=true
BILLKO_PLEIS_API_KEY=
BILLKO_ENCRYPTION_KEY=
# Live Billko fiscalization (ticketing invoices, subscription e-invoices, commission eRačun).
# Must be exactly "true" for live createInvoice / fiscal writes. Default off = skip all live Billko fiscalization.
# Payment confirmations (ordering / reservation / ticketing PC) still run when this is false.
BILLKO_FISCALIZE_ENABLED=false
# Live ticket invoice storno on Monri refund. Default off — dry-run / planned only until set to "true".
BILLKO_STORNO_ENABLED=false
# BillKO Imperial Lake (Fiscalization 2.0 B2B eInvoices / payment reporting).
# Separate from BILLKO_PLEIS_API_KEY (/api-client). Base defaults to https://app.billko.eu
BILLKO_LAKE_ENABLED=false
BILLKO_LAKE_BASE_URL=https://app.billko.eu
# Prefer a stored lake API key, OR username/password (+ vatId, defaults to PLEIS_OIB)
BILLKO_LAKE_API_KEY=
BILLKO_LAKE_USERNAME=
BILLKO_LAKE_PASSWORD=
BILLKO_LAKE_VAT_ID=
PLEIS_LEGAL_NAME=UTOPIA TECHNOLOGIES d.o.o.
PLEIS_OIB=34839111725
PLEIS_ADDRESS=Palinovečka ulica 19K, 10000 Zagreb, Hrvatska
PLEIS_BRAND=PLEIS
PLEIS_WEB=https://pleis.hr
PLEIS_SUPPORT_EMAIL=support@pleis.hr

# Pleis SEPA Instant payout (pain.001) — locked vs operating must differ
PLEIS_NAME=
PLEIS_LOCKED_IBAN=
PLEIS_LOCKED_ACCOUNT_NAME=
PLEIS_LOCKED_BIC=
PLEIS_OPERATING_IBAN=
PLEIS_OPERATING_ACCOUNT_NAME=
PLEIS_OPERATING_ACCOUNT_OIB=
PLEIS_ADDRESS_STREET=
PLEIS_ADDRESS_BUILDING_NO=
PLEIS_ADDRESS_POSTCODE=
PLEIS_ADDRESS_TOWN=
PLEIS_ADDRESS_COUNTRY=HR
# Optional tip commission % (SubscriptionSettings has no tip field yet); default 0
PLEIS_TIP_COMMISSION_RATE=0
PLEIS_ORDERING_COMMISSION=0.03
PLEIS_TICKETING_COMMISSION=0.03
PLEIS_TIP_COMMISSION=0
# Optional public HTTPS logo for emails (recommended). If unset, Mailgun inlines assets/pleis-logo.png via cid:.
PLEIS_LOGO_URL=
# "Open in the app" uses API_BASE_URL + /app/open (same smart-redirect as global-referral share)
PLEIS_APP_SCHEME=com.pleis
PLEIS_IOS_STORE_URL=https://apps.apple.com/app/pleisapp/id1234567890
PLEIS_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.pleis

# Monri Payment Gateway (set per environment — no hardcoded hosts in code)
# test: https://ipgtest.monri.com  prod: https://ipg.monri.com
MONRI_BASE_URL=
MONRI_KEY=
MONRI_AUTH_TOKEN=
MONRI_COMPONENTS_ENV=test
MONRI_CURRENCY=EUR
MONRI_LANGUAGE=en
MONRI_COUNTRY=HR
MONRI_LOCALE=en-US
MONRI_WEBHOOK_SECRET=
# Live card refunds via POST /payments/monri/refund. Default off.
MONRI_LIVE_REFUND_ENABLED=false
SUCCESS_URL=
CANCEL_URL=

#REDIS settings
REDIS_URL=

# CORS extras (LAN / tunnels / previews). Brand origins are in backend/config/CONSTANTS.js
EXTRA_CORS_ORIGINS=
# Comma-separated IPs allowed for POST createAdmin (token still required)
ADMIN_SIGNUP_ALLOWED_IPS=127.0.0.1,::1
FIREBASE_DATABASE_URL=
# Optional Mailgun From override (default: Pleis <noreply@{MAILGUN_DOMAIN}>)
MAIL_FROM=Pleis <noreply@pleis.ai>
